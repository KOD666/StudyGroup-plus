# ==============================================================================
# StudyGroup+ Environment Configuration Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local to version control.
# ==============================================================================

# Database (Neon Serverless PostgreSQL)
# Obtain from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Authentication (Clerk)
# Obtain from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_key
CLERK_SECRET_KEY=sk_test_sample_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Object Storage (Cloudflare R2, Backblaze B2, or S3-compatible)
# Note: For local development, if unconfigured, StudyGroup+ automatically
# falls back to transparent local disk storage (.storage/).
#
# Option A - Cloudflare R2:
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=your-r2-bucket-name
#
# Option B - Backblaze B2 or generic S3:
STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key
STORAGE_BUCKET=your-storage-bucket-name
STORAGE_REGION=us-east-005

# LiveKit WebRTC (Video / Audio Rooms)
# For local dev: run LiveKit server on localhost:7880 with devkey/secret
# For production: set to your self-hosted VPS LiveKit server URL
LIVEKIT_URL=wss://livekit.yourdomain.com
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret