{
  "name": "studygroup-plus-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env.local scripts/db-check.cjs && next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/.bin/drizzle-kit migrate",
    "db:check": "node --env-file=.env.local scripts/db-check.cjs",
    "lint": "next lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "livekit": "./infra/bin/livekit-server --dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@clerk/nextjs": "^7.9.4",
    "@livekit/track-processors": "^0.8.1",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.39.3",
    "emoji-picker-react": "^4.22.2",
    "framer-motion": "^13.4.0",
    "lenis": "^1.3.26",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "lucide-react": "^1.47.0",
    "next": "^15.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.3.9",
    "postcss": "^8.5.0",
    "prettier": "^3.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
